# ---- Application ----
APP_ENV=local
GIT_SHA=local
PROMPT_VERSION=latest

# ---- LLM / AI Gateway ----
GOOGLE_API_KEY=your-gemini-api-key
GATEWAY_PROVIDER=litellm
GATEWAY_DEFAULT_MODEL=gemini/gemini-2.5-flash
GATEWAY_DAILY_BUDGET_USD=10.0
GATEWAY_MONTHLY_BUDGET_USD=500.0
GATEWAY_BUDGET_DOWNGRADE_MODEL=gemini/gemini-2.0-flash
GATEWAY_REDACT_PII=true
# GATEWAY_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
# GATEWAY_PROVIDER=bedrock
# BEDROCK_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# ---- Observability ----
OBS_LOG_LEVEL=INFO
OBS_PROMETHEUS_ENABLED=true
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# LOGFIRE_ENABLED=true
# LOGFIRE_TOKEN=
# LOGFIRE_SERVICE_NAME=multi-agent-factory
# OBS_OTEL_ENDPOINT=http://localhost:4317

# ---- Cache ----
CACHE_BACKEND=memory
# CACHE_REDIS_URL=redis://localhost:6379/0

# ---- Database ----
DB_HOT_URL=sqlite+aiosqlite:///./data/hot_state.db
DB_COLD_URL=sqlite+aiosqlite:///./data/cold_state.db

# ---- Vector Store ----
VECTOR_BACKEND=memory
VECTOR_EMBEDDING_MODEL=text-embedding-004
VECTOR_EMBEDDING_MODEL_VERSION=v1
# VECTOR_BACKEND=opensearch
# VECTOR_OPENSEARCH_URL=http://localhost:9200
# VECTOR_OPENSEARCH_USERNAME=
# VECTOR_OPENSEARCH_PASSWORD=
# VECTOR_OPENSEARCH_VERIFY_CERTS=true

# ---- Documents ----
PDF_BACKEND=docling
PDF_MAX_PAGES=100
PDF_MAX_FILE_SIZE_MB=20

# ---- Agent Protocols ----
ADK_ENABLED=false
# ADK_APP_NAME=multi-agent-factory
# ADK_DEFAULT_MODEL=gemini-2.5-flash
A2A_ENABLED=false
# A2A_PUBLIC_BASE_URL=http://127.0.0.1:8000
# A2A_JSONRPC_PATH=/a2a/jsonrpc
# A2A_REST_PATH=/a2a/rest

# ---- Eval ----
EVAL_BACKEND=local
# EVAL_BACKEND=deepeval
EVAL_THRESHOLD=0.8
# EVAL_MODEL=gpt-4o

# ---- Security ----
SECURITY_SECRETS_BACKEND=env
SECURITY_ENABLE_GUARDRAILS=true
SECURITY_CONTENT_GUARDRAIL_BACKEND=passthrough
# BEDROCK_GUARDRAIL_ID=
# BEDROCK_GUARDRAIL_VERSION=DRAFT
SECURITY_AUDIT_LOG_PATH=./data/audit.log
SECURITY_RETENTION_DAYS=90
# SECURITY_OIDC_ISSUER=https://your-idp.example.com

# ---- Optional Connectors ----

# ---- Multi-Tenancy ----
TENANT_DEFAULT_TENANT_ID=default
TENANT_ISOLATION_MODE=logical
