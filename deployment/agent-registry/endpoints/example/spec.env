SERVICE_ID="example-endpoint"
DISPLAY_NAME="Example Endpoint"
DESCRIPTION="A reachable MCP/A2A endpoint with no tool spec."

SPEC_KIND="endpoint"
SPEC_TYPE="NO_SPEC"             # endpoints carry no spec content

SERVER_URL="https://example.com/mcp"
PROTOCOL_BINDING="JSONRPC"      # JSONRPC | HTTP_JSON | GRPC
